rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo público: lectura libre por el cliente, mutación solo por Admin SDK en servidor
    match /services/{id}   { allow read: if true;  allow write: if false; }
    match /categories/{id} { allow read: if true;  allow write: if false; }

    // Todo lo demás (citas, slots, clientas, usuarios, profesionales, configuración):
    // Denegado el acceso directo desde el SDK de cliente. Todo pasa por Server Actions con Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
